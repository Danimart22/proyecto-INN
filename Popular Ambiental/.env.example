# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# "true" para conectar a SIATA y Datos Abiertos Medellin.
# "false" usa datos simulados y funciona sin internet.
PRODUCCION=false

# Token del bot de Telegram (lo obtienes con @BotFather en Telegram)
TELEGRAM_TOKEN=

# Credenciales de Twilio para WhatsApp (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Puerto para el servidor Flask de WhatsApp
PORT=5000
